{
  "name": "@codekanban/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "test": "vitest run",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint --config .oxlintrc.json . --deny-warnings",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:fix:oxlint": "oxlint --config .oxlintrc.json . --fix --deny-warnings",
    "lint:fix:eslint": "eslint . --fix",
    "lint:fix": "run-s lint:fix:oxlint lint:fix:eslint",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "run-p type-check lint test"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-document": "3.29.2",
    "@tiptap/extension-hard-break": "3.29.2",
    "@tiptap/extension-paragraph": "3.29.2",
    "@tiptap/extension-text": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/vue-3": "3.29.2",
    "@vicons/ionicons5": "^0.12.0",
    "@vueuse/core": "^14.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.3.0",
    "alova": "^3.3.4",
    "dayjs": "^1.11.18",
    "es-toolkit": "^1.39.10",
    "eventemitter3": "^5.0.1",
    "filesize": "^11.0.13",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.0",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "sortablejs": "^1.14.0",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@alova/wormhole": "^1.2.0",
    "@prettier/plugin-oxc": "^0.0.4",
    "@tailwindcss/vite": "^4.1.13",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@types/sortablejs": "^1.15.9",
    "@types/web": "^0.0.154",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-oxlint": "~1.8.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.8.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "vfonts": "^0.0.3",
    "vite": "npm:rolldown-vite@latest",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.0.4"
  }
}
